generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Atleta {
  id_atleta           Int                    @id @default(autoincrement())
  nome_atleta         String                 @db.VarChar(100)
  email               String                 @unique @db.VarChar(150)
  telefone_celular    String?                @db.VarChar(20)
  cidade              String?                @db.VarChar(80)
  nivelHabilidade     nivel_habilidade_enum? @map("nivel_habilidade")
  posicaoPreferencial String?                @map("posicao_preferencial") @db.VarChar(30)
  senha_hash          String                 @db.VarChar(255)
  compoe              ComposicaoDupla[]
  disponibilidade     Disponibilidade[]
  pertence            Pertence[]

  @@map("atleta")
}

model Disponibilidade {
  id_disponibilidade Int             @id @default(autoincrement())
  diaSemana          dia_semana_enum @map("dia_semana")
  horario_inicio     DateTime        @db.Time(6)
  horario_fim        DateTime        @db.Time(6)
  id_atleta          Int
  atleta             Atleta          @relation(fields: [id_atleta], references: [id_atleta], onDelete: Cascade, onUpdate: NoAction, map: "fk_disponibilidade_atleta")

  @@index([id_atleta], map: "idx_disponibilidade_atleta")
  @@map("disponibilidade")
}

model Comunidade {
  id_comunidade Int        @id @default(autoincrement())
  nome_grupo    String     @db.VarChar(100)
  descricao     String?
  partida       Partida[]
  pertence      Pertence[]

  @@map("comunidade")
}

model Pertence {
  id_atleta     Int
  id_comunidade Int
  atleta        Atleta     @relation(fields: [id_atleta], references: [id_atleta], onDelete: Cascade, onUpdate: NoAction, map: "fk_pertence_atleta")
  comunidade    Comunidade @relation(fields: [id_comunidade], references: [id_comunidade], onDelete: Cascade, onUpdate: NoAction, map: "fk_pertence_comunidade")

  @@id([id_atleta, id_comunidade])
  @@index([id_comunidade], map: "idx_pertence_comunidade")
  @@map("pertence")
}

model Dupla {
  id_dupla   Int               @id @default(autoincrement())
  nome_dupla String            @db.VarChar(100)
  compoe     ComposicaoDupla[]
  joga       JogaPartida[]

  @@map("dupla")
}

model ComposicaoDupla {
  id_atleta Int
  id_dupla  Int
  atleta    Atleta @relation(fields: [id_atleta], references: [id_atleta], onDelete: Cascade, onUpdate: NoAction, map: "fk_compoe_atleta")
  dupla     Dupla  @relation(fields: [id_dupla], references: [id_dupla], onDelete: Cascade, onUpdate: NoAction, map: "fk_compoe_dupla")

  @@id([id_atleta, id_dupla])
  @@index([id_dupla], map: "idx_compoe_dupla")
  @@map("compoe")
}

model Partida {
  id_partida     Int           @id @default(autoincrement())
  dataHora       DateTime      @map("data_hora") @db.Timestamp(6)
  tipo_partida   String?       @db.VarChar(30)
  status_partida String        @default("agendada") @db.VarChar(20)
  id_comunidade  Int
  joga           JogaPartida[]
  comunidade     Comunidade    @relation(fields: [id_comunidade], references: [id_comunidade], onUpdate: NoAction, map: "fk_partida_comunidade")
  resultado      Resultado[]

  @@index([id_comunidade], map: "idx_partida_comunidade")
  @@index([dataHora], map: "idx_partida_data_hora")
  @@map("partida")
}

model JogaPartida {
  id_dupla   Int
  id_partida Int
  dupla      Dupla   @relation(fields: [id_dupla], references: [id_dupla], onDelete: Cascade, onUpdate: NoAction, map: "fk_joga_dupla")
  partida    Partida @relation(fields: [id_partida], references: [id_partida], onDelete: Cascade, onUpdate: NoAction, map: "fk_joga_partida")

  @@id([id_dupla, id_partida])
  @@index([id_partida], map: "idx_joga_partida")
  @@map("joga")
}

model Resultado {
  id_resultado  Int     @id @default(autoincrement())
  numero_set    Int     @db.SmallInt
  pontos_dupla1 Int     @default(0) @db.SmallInt
  pontos_dupla2 Int     @default(0) @db.SmallInt
  id_partida    Int
  partida       Partida @relation(fields: [id_partida], references: [id_partida], onDelete: Cascade, onUpdate: NoAction, map: "fk_resultado_partida")

  @@unique([id_partida, numero_set], map: "uq_resultado_partida_set")
  @@index([id_partida], map: "idx_resultado_partida")
  @@map("resultado")
}

enum dia_semana_enum {
  seg
  ter
  qua
  qui
  sex
  sab
  dom
}

enum nivel_habilidade_enum {
  iniciante
  intermediario
  avancado
  profissional
}
